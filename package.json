{
  "name": "tessera",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Tessera - a voxel open-world action-RPG on floating islands above a sea of clouds.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "app": "vite build && electron .",
    "app:build": "vite build && electron-packager . TESSERA --platform=darwin --arch=arm64 --out=release --overwrite --app-category-type=public.app-category.games --app-bundle-id=com.tessera.game --ignore=\"^/(src|docs|reference|release|public|desktop/.*\\.md)(/|$)\""
  },
  "dependencies": {
    "simplex-noise": "^4.0.3",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@electron/packager": "^18.4.4",
    "electron": "^41.7.1",
    "vite": "^6.4.3"
  },
  "main": "desktop/main.cjs"
}
